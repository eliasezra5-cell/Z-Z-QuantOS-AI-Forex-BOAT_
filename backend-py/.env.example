# ---------------------------------------------------------------------------
# AI Provider Clients (USER_LLM_* variables)
# ---------------------------------------------------------------------------
# Provide your own API keys here. The AI Brain reads these variables at boot
# and registers the matching providers into the failover chain. The built-in
# local heuristic fallback is always enabled, so the system keeps working even
# with no keys configured.

# Primary provider via any OpenAI-compatible endpoint (OpenAI, DeepSeek, Ollama, ...)
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_API_KEY=your-api-key-here
USER_LLM_MODEL=deepseek-chat

# Optional: Anthropic (Claude) as an additional failover provider
USER_LLM_ANTHROPIC_API_KEY=
USER_LLM_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Google Gemini as an additional failover provider
USER_LLM_GEMINI_API_KEY=
USER_LLM_GEMINI_MODEL=gemini-2.0-flash

# Optional: OpenRouter (multi-model aggregator) as an additional provider
USER_LLM_OPENROUTER_API_KEY=
USER_LLM_OPENROUTER_MODEL=deepseek/deepseek-chat

# Optional: z.ai / GLM (Zhipu) as an additional provider
USER_LLM_GLM_API_KEY=
USER_LLM_GLM_MODEL=glm-4-plus

# Optional: Azure OpenAI (deployment-scoped endpoint). Enabled only when both a
# key and an endpoint are set — existing providers are never affected.
USER_LLM_AZURE_API_KEY=
USER_LLM_AZURE_ENDPOINT=https://<resource>.openai.azure.com
USER_LLM_AZURE_DEPLOYMENT=gpt-4o
USER_LLM_AZURE_API_VERSION=2024-06-01
USER_LLM_AZURE_MODEL=

# Optional: streaming completions, token budget and cost tracking
# AI_STREAMING=false
# AI_TOKEN_BUDGET_PER_CALL=2000
# AI_COST_TRACKING=true

# Optional: explicit provider priority for failover (comma-separated ids, e.g.
# "openai-compatible,openrouter,glm,anthropic,gemini,local-fallback")
# AI_PROVIDER_PRIORITY=

# Optional overrides for resilience behaviour (defaults come from app config)
# USER_LLM_TIMEOUT_SECONDS=120
# USER_LLM_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Daily report delivery (Feature 4: email / WhatsApp / Telegram)
# ---------------------------------------------------------------------------
# Each channel is independently toggled and fails safe. Leave credentials
# empty to skip a channel silently (recorded "pending" in integration_outbox).

# Email (SMTP) — empty host/from = email skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=quantos@yourdomain.com
EMAIL_TO=you@yourdomain.com
EMAIL_SUBJECT_PREFIX=QuantOS AI

# WhatsApp (Meta Graph API) — empty token = whatsapp skipped
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_WEBHOOK_SECRET=

# Telegram bot — empty token = telegram skipped
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Schedule + toggles (default: all ON, every 24h)
REPORT_DELIVERY_INTERVAL_SECONDS=86400
REPORT_DELIVERY_EMAIL_ENABLED=true
REPORT_DELIVERY_WHATSAPP_ENABLED=true
REPORT_DELIVERY_TELEGRAM_ENABLED=true

# The delivery job runs on the in-process scheduler at boot (no Celery needed).
# Celery beat is only for the institutional stack (Redis + worker + beat).
CELERY_BEAT_SCHEDULE_ENABLED=true

# ---------------------------------------------------------------------------
# Reddit news (optional; RSS fallback when creds missing)
# ---------------------------------------------------------------------------
# Without these the collector uses the public RSS feed (no auth).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# X / Twitter news (optional; two independent free paths)
# ---------------------------------------------------------------------------
# 1) Official X API v2: set a Bearer token (X Developer portal). With this set,
#    every enabled X source is fetched through the official API instead of Nitter.
TWITTER_BEARER_TOKEN=

# 2) Free Nitter RSS path (used when no bearer token). Pick a primary host:
NITTER_HOST=nitter.net

# Extra Nitter instances tried automatically when the primary host is down.
# Comma-separated, tried in order until one responds.
NITTER_FALLBACK_HOSTS=nitter.privacyredirect.com,nitter.tiekoetter.com,xcancel.com,nitter.poast.org,lightbrd.com

# Note: most public Nitter instances now gate RSS behind browser/whitelist
# checks, so the reliable free path is an X API token. The collector tries every
# host in order and reports honestly if none respond.

# ---------------------------------------------------------------------------
# Pro add-on data sources (optional; features degrade gracefully when missing)
# ---------------------------------------------------------------------------
# FRED (St. Louis Fed) — Fixed Income module (/api/pro/fixedincome).
# Missing key = simulator yield curve, feature still works.
FRED_API_KEY=

# Official macro sources — Extra Macro module (/api/pro/macro/{source}/{id}).
# Missing keys = source reports "not configured", feature degrades gracefully.
ECB_API_KEY=
OECD_API_KEY=
EIA_API_KEY=
BLS_API_KEY=

# Institutional / smart-money flow module (/api/pro/institutional/*).
# Missing keys = sources degrade to flagged simulator data, feature still works.
FINRA_API_KEY=
CONGRESS_GOV_API_KEY=
SEC_USER_AGENT=

# Extra premium news sources (registered into the news feed automatically).
# Missing keys just disable that source's live feed; others keep working.
BENZINGA_API_KEY=
WSJ_API_KEY=
SEEKING_ALPHA_API_KEY=

# Derivatives module (/api/pro/derivatives/*). Optional.
# Missing key = simulated options chain / unusual activity / futures curve.
POLYGON_API_KEY=

# Prediction Markets module (/api/pro/prediction-markets/*). Optional.
# Polymarket's public Gamma read endpoints require no key today; this is kept
# as a placeholder in case a future paid tier needs it. Nothing depends on it.
POLYMARKET_API_KEY=

# Kronos forecast module (/api/pro/forecast/*). Optional.
# The model package ships with the official Kronos repo and is fetched
# automatically on first use. Point KRONOS_REPO_PATH at a local checkout to
# skip the auto-clone. When torch / the repo / the model cannot be reached the
# endpoint degrades to {"status": "unavailable"} — it never blocks startup.
KRONOS_REPO_PATH=
