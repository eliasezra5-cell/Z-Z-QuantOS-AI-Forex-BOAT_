# ---------------------------------------------------------------------------
# ZZ_QuantOS AI BOAT — PRODUCTION ENVIRONMENT
# Copy to `.env` next to docker-compose.prod.yml, fill in your values.
# NEVER commit the real `.env` file. RULES for going live are in docs/DEPLOYMENT.md
# ---------------------------------------------------------------------------

# ---- Core ----
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PORT=3001
HOST=0.0.0.0

# REQUIRED for production: generate with `openssl rand -hex 32`
# Used to sign auth JWTs. A leaked/weak secret is a security hole.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ---- Persistence ----
# The verified live setup uses the JSON file store (no external DB).
# Leave Postgres/Celery DISABLED unless you deploy the full institutional stack
# (legacy docker-compose.yml with pgvector + Redis + Celery).
POSTGRES_ENABLED=false
CELERY_ENABLED=false
DATABASE_URL=
REDIS_URL=

# ---- AI providers (YOUR OWN API KEYS) ----
# The platform keys in the agent environment are never used by this project.
# Register at the provider, create an API key, and paste it here.
# Primary provider (any OpenAI-compatible endpoint: DeepSeek, OpenAI, Ollama, ...)
USER_LLM_BASE_URL=https://api.deepseek.com/v1
USER_LLM_API_KEY=your-api-key-here
USER_LLM_MODEL=deepseek-chat

# Optional failover providers (leave empty to skip)
USER_LLM_ANTHROPIC_API_KEY=
USER_LLM_ANTHROPIC_MODEL=claude-sonnet-4-20250514
USER_LLM_GEMINI_API_KEY=
USER_LLM_GEMINI_MODEL=gemini-2.0-flash
USER_LLM_OPENROUTER_API_KEY=
USER_LLM_OPENROUTER_MODEL=deepseek/deepseek-chat
USER_LLM_GLM_API_KEY=
USER_LLM_GLM_MODEL=glm-4-plus

# Optional Batch 02 providers (additive; leave empty to skip)
USER_LLM_XAI_API_KEY=
USER_LLM_XAI_MODEL=grok-3
USER_LLM_DASHSCOPE_API_KEY=
USER_LLM_DASHSCOPE_MODEL=qwen-plus
USER_LLM_DASHSCOPE_CN_API_KEY=
USER_LLM_DASHSCOPE_CN_MODEL=qwen-plus
USER_LLM_ZHIPU_API_KEY=
USER_LLM_ZHIPU_MODEL=glm-4.6
USER_LLM_MINIMAX_API_KEY=
USER_LLM_MINIMAX_MODEL=MiniMax-Text-01
USER_LLM_MINIMAX_CN_API_KEY=
USER_LLM_MINIMAX_CN_MODEL=MiniMax-Text-01
USER_LLM_NVIDIA_API_KEY=
USER_LLM_NVIDIA_MODEL=deepseek-ai/deepseek-r1

# Alpha Vantage market data feed (non-LLM; optional)
ALPHA_VANTAGE_API_KEY=

# Optional AI behaviour
AI_PROVIDER_PRIORITY=
AI_STREAMING=false
AI_TOKEN_BUDGET_PER_CALL=2000
AI_COST_TRACKING=true

# ---- Trading / risk (fail-closed safety defaults) ----
TRADING_MODE=analysis
CONFIDENCE_THRESHOLD=90
CONFIDENCE_SUGGEST_THRESHOLD=70
MAX_RISK_PER_TRADE=2
MAX_TOTAL_EXPOSURE=30
DAILY_LOSS_LIMIT=5
WEEKLY_LOSS_LIMIT=300
MAX_DRAWDOWN_PERCENT=15
MAX_SPREAD_PIPS=3
MAX_SLIPPAGE_PIPS=2
STALE_DATA_THRESHOLD_SECONDS=30
DEFAULT_RR_RATIO=2

# ---- MT5 (leave demo until the bridge machine is ready) ----
# MT5_ENABLED=demo  -> orders go through the local trading engine (no broker)
# MT5_ENABLED=live  -> orders are forwarded to your MT5 terminal via the bridge
MT5_ENABLED=demo
MT5_BRIDGE_URL=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_HOST=127.0.0.1
MT5_PORT=443

# ---- Optional: Binance market data ----
BINANCE_API_KEY=
BINANCE_SECRET=

# ---- Scheduler ----
SCHEDULER_TZ=UTC

# ---- Reddit news (optional; RSS fallback when creds missing) ----
# Fills the Reddit news collector. Without these the collector uses the
# public RSS feed (no auth). For the richer PRAW path you ALSO need the
# `praw` package installed (pip install praw, present in requirements.txt).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- X / Twitter news (optional; two independent free paths) ----
# 1) Official X API v2 Bearer token (X Developer portal). With this set, every
#    enabled X source is fetched through the official API instead of Nitter.
TWITTER_BEARER_TOKEN=
# 2) Free Nitter RSS path (used when no bearer token). Primary host:
NITTER_HOST=nitter.net
# Extra Nitter instances tried automatically when the primary host is down.
NITTER_FALLBACK_HOSTS=nitter.privacyredirect.com,nitter.tiekoetter.com,xcancel.com,nitter.poast.org,lightbrd.com
# Note: most public Nitter instances now gate RSS behind browser/whitelist
# checks, so the reliable free path is an X API token.

# ---- Daily report delivery (Feature 4) ----
# Generates the daily report and pushes it over each configured channel.
# Every channel is INDEPENDENTLY toggled and fails safe: leave a channel's
# credentials empty and it is skipped silently (recorded "pending" in the
# integration_outbox). Enable only the channels you actually use.

# Email (SMTP) — empty host/frm = email skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=quantos@yourdomain.com
EMAIL_TO=you@yourdomain.com
EMAIL_SUBJECT_PREFIX=QuantOS AI

# WhatsApp (Meta Graph API) — empty token = whatsapp skipped
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_WEBHOOK_SECRET=

# Telegram bot — empty token = telegram skipped
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Delivery schedule + per-channel toggles (default: all ON, every 24h)
# The job is registered on the in-process scheduler at boot, so it runs
# automatically even WITHOUT Celery/Redis (see "Scheduler vs Celery beat").
REPORT_DELIVERY_INTERVAL_SECONDS=86400
REPORT_DELIVERY_EMAIL_ENABLED=true
REPORT_DELIVERY_WHATSAPP_ENABLED=true
REPORT_DELIVERY_TELEGRAM_ENABLED=true

# ---- Scheduler vs Celery beat (READ THIS) ----
# The in-process scheduler (threading.Timer, no broker needed) ALREADY runs:
#   - daily-report-delivery  (Feature 4, every REPORT_DELIVERY_INTERVAL_SECONDS)
# when the API container boots (registered in app/main.py). News polling runs
# on its own background loop thread — also automatic. No extra process needed
# for any of these.
#
# Celery beat is ONLY needed for the institutional stack (docker-compose.yml
# with Redis). Start worker + beat there:
#   celery -A app.tasks.celery_app worker -l info
#   celery -A app.tasks.celery_app beat  -l info
# Requires CELERY_BROKER_URL/CELERY_RESULT_BACKEND + CELERY_BEAT_SCHEDULE_ENABLED=true.
# In the simple production stack (docker-compose.prod.yml) leave:
CELERY_ENABLED=false
CELERY_BEAT_SCHEDULE_ENABLED=true
