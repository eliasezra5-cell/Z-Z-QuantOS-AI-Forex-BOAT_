# Build/deploy-time configuration for the React frontend.
# Vite exposes any variable prefixed with VITE_ to `import.meta.env`.
#
# Leave unset for same-origin mode (dev-server proxy or the nginx reverse proxy
# in the production Docker image): the app then calls `/api` on its own origin.
#
# Set this when the frontend is served from a different origin than the
# backend (e.g. a static/preview host without the nginx /api proxy). It is
# baked in at `npm run build` time, so rebuild after changing it.
VITE_API_URL=
